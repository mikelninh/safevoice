{
  "buildCommand": "cd frontend && npm ci && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "functions": {
    "api/proxy.py": {
      "maxDuration": 300,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/proxy?_p=$1" },
    { "source": "/((?!api/|assets|manifest|sw\\.js|workbox).*)", "destination": "/index.html" }
  ]
}
